{
  "name": "hexo-admin-panel",
  "version": "3.5.0",
  "description": "A modular Vue-powered admin dashboard with direct Hexo API integration",
  "main": "index.js",
  "scripts": {
    "dev": "vite --config admin/vite.config.js --configLoader runner",
    "build": "vite build --config admin/vite.config.js --configLoader runner",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test test/api.test.js test/frontend-structure.test.js test/unit/pure-functions.test.js",
    "test:ui": "vitest run --config admin/vite.config.js --configLoader runner",
    "test:browser": "node --test test/preview-browser.test.js",
    "test:coverage:node": "node --experimental-test-coverage --test test/api.test.js test/frontend-structure.test.js test/unit/pure-functions.test.js",
    "test:coverage:ui": "vitest run --coverage --config admin/vite.config.js --configLoader runner",
    "coverage": "npm run test:coverage:node && npm run test:coverage:ui",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "prepack": "npm run check"
  },
  "keywords": [
    "hexo",
    "hexo-plugin",
    "admin",
    "dashboard",
    "cms",
    "blog",
    "hexo-admin"
  ],
  "author": "Skylarr Kuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skylarrkuo/hexo-admin-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Skylarrkuo/hexo-admin-panel/issues"
  },
  "homepage": "https://github.com/Skylarrkuo/hexo-admin-panel#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "lib/",
    "dist/",
    "assets/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README_EN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "hexo-front-matter": "^4.2.1",
    "js-yaml": "^4.3.1",
    "sharp": "^0.34.4",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "hexo": ">=4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "dompurify": "^3.4.14",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "marked": "^15.0.7",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.20"
  }
}
